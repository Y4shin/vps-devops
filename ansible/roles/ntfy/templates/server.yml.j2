# Generated by Ansible — do not edit manually
#
# ntfy configuration

base-url: https://ntfy.{{ secrets.domain }}
listen-http: :{{ ntfy_internal_port }}

# Auth
auth-file: /var/lib/ntfy/auth.db
auth-default-access: {{ ntfy_auth_default_access }}

# Caching
cache-file: /var/lib/ntfy/cache.db
cache-duration: "{{ ntfy_cache_duration }}"

# Attachments
attachment-cache-dir: /var/lib/ntfy/attachments

# Behind proxy (Traefik handles TLS, we speak HTTP internally)
behind-proxy: true

# Keep logs clean  — healthcheck pings /health endpoint
healthcheck-enabled: true
