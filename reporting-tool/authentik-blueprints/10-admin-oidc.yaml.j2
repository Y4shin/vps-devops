version: 1
metadata:
  name: reporting-tool-admin-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: reporting_tool_admin_access_group
    state: present
    identifiers:
      name: {{ reporting_tool_admin_access_group | to_json }}
    attrs:
      name: {{ reporting_tool_admin_access_group | to_json }}

  - model: authentik_providers_oauth2.scopemapping
    id: reporting_tool_profile_groups_scope
    state: present
    identifiers:
      name: reporting-tool profile groups
    attrs:
      name: reporting-tool profile groups
      scope_name: profile
      description: Emit reporting-tool Authentik groups in the OIDC profile claim.
      expression: |
        return {
            "groups": [
                group.name
                for group in request.user.ak_groups.all()
                if group.name.startswith("reporting-tool-")
            ]
        }

  - model: authentik_policies_expression.expressionpolicy
    id: reporting_tool_admin_access_policy
    state: present
    identifiers:
      name: reporting-tool admin requires {{ reporting_tool_admin_access_group }}
    attrs:
      name: reporting-tool admin requires {{ reporting_tool_admin_access_group }}
      expression: |
        user = getattr(request, "user", None)
        return bool(
            user
            and user.is_authenticated
            and user.ak_groups.filter(name={{ reporting_tool_admin_access_group | to_json }}).exists()
        )

  - model: authentik_providers_oauth2.oauth2provider
    id: reporting_tool_admin_oidc_provider
    state: present
    identifiers:
      name: reporting-tool admin oidc
    attrs:
      name: reporting-tool admin oidc
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      client_type: confidential
      client_id: {{ reporting_tool_admin_oidc_client_id | to_json }}
      client_secret: {{ reporting_tool_secrets.ADMIN_OIDC_CLIENT_SECRET | to_json }}
      redirect_uris:
        - url: https://witness.{{ secrets.domain }}/admin/login/oidc/callback
          matching_mode: strict
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf reporting_tool_profile_groups_scope
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]

  - model: authentik_core.application
    id: reporting_tool_admin_application
    state: present
    identifiers:
      slug: {{ reporting_tool_admin_oidc_application_slug | to_json }}
    attrs:
      name: Witness Admin
      slug: {{ reporting_tool_admin_oidc_application_slug | to_json }}
      provider: !KeyOf reporting_tool_admin_oidc_provider
      icon: https://authentik.{{ secrets.domain }}/media/custom/witness-icon.svg
      meta_launch_url: https://witness.{{ secrets.domain }}/admin/login
      meta_description: Authentik OIDC login for the Witness admin console
      meta_publisher: vps-devops

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf reporting_tool_admin_application
      policy: !KeyOf reporting_tool_admin_access_policy
      order: 0
