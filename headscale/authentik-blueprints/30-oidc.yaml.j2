version: 1
metadata:
  name: headscale-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: headscale_access_group
    state: present
    identifiers:
      name: {{ headscale_access_group | to_json }}
    attrs:
      name: {{ headscale_access_group | to_json }}
      # Seed with the bootstrap admin so the operator isn't locked out on day one.
      users:
        - !Find [authentik_core.user, [username, akadmin]]

  - model: authentik_policies_expression.expressionpolicy
    id: headscale_access_policy
    state: present
    identifiers:
      name: headscale requires {{ headscale_access_group }}
    attrs:
      name: headscale requires {{ headscale_access_group }}
      expression: |
        user = getattr(request, "user", None)
        return bool(
            user
            and user.is_authenticated
            and user.ak_groups.filter(name={{ headscale_access_group | to_json }}).exists()
        )
{% if headscale_secrets.OIDC_CLIENT_SECRET is defined and (headscale_secrets.OIDC_CLIENT_SECRET | trim) != '' %}

  - model: authentik_providers_oauth2.oauth2provider
    id: headscale_oidc_provider
    state: present
    identifiers:
      name: headscale oidc
    attrs:
      name: headscale oidc
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      client_type: confidential
      client_id: {{ headscale_oidc_client_id | to_json }}
      client_secret: {{ headscale_secrets.OIDC_CLIENT_SECRET | to_json }}
      # Headscale's OIDC callback path is fixed.
      redirect_uris:
        - url: https://headscale.{{ secrets.domain }}/oidc/callback
          matching_mode: strict
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      # IMPORTANT: leave the Encryption Key unset — headscale does not support
      # JSON Web Encryption.

  - model: authentik_core.application
    id: headscale_application
    state: present
    identifiers:
      slug: {{ headscale_application_slug | to_json }}
    attrs:
      name: Headscale
      slug: {{ headscale_application_slug | to_json }}
      provider: !KeyOf headscale_oidc_provider
      meta_launch_url: https://headscale.{{ secrets.domain }}
      meta_description: Tailscale control server
      meta_publisher: vps-devops

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf headscale_application
      policy: !KeyOf headscale_access_policy
      order: 0
{% endif %}
