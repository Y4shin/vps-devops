version: 1
metadata:
  name: conference-tool-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_policies_expression.expressionpolicy
    id: conference_tool_access_policy
    state: present
    identifiers:
      name: conference-tool requires {{ conference_tool_access_group }} or {{ conference_tool_admin_group }}
    attrs:
      name: conference-tool requires {{ conference_tool_access_group }} or {{ conference_tool_admin_group }}
      expression: |
        user = getattr(request, "user", None)
        return bool(
            user
            and user.is_authenticated
            and user.ak_groups.filter(
                name__in=[{{ conference_tool_access_group | to_json }}, {{ conference_tool_admin_group | to_json }}]
            ).exists()
        )
{% if conference_tool_secrets.OAUTH_CLIENT_SECRET is defined and (conference_tool_secrets.OAUTH_CLIENT_SECRET | trim) != '' %}

  - model: authentik_providers_oauth2.oauth2provider
    id: conference_tool_oidc_provider
    state: present
    identifiers:
      name: conference-tool oidc
    attrs:
      name: conference-tool oidc
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      client_type: confidential
      client_id: {{ conference_tool_oidc_client_id | to_json }}
      client_secret: {{ conference_tool_secrets.OAUTH_CLIENT_SECRET | to_json }}
      redirect_uris:
        - url: https://conference.{{ secrets.domain }}/oauth/callback
          matching_mode: strict
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [name, "conference-tool profile groups"]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]

  - model: authentik_core.application
    id: conference_tool_application
    state: present
    identifiers:
      slug: {{ conference_tool_application_slug | to_json }}
    attrs:
      name: Conference Tool
      slug: {{ conference_tool_application_slug | to_json }}
      provider: !KeyOf conference_tool_oidc_provider
      icon: https://authentik.{{ secrets.domain }}/media/custom/conference-tool-icon.svg
      meta_launch_url: https://conference.{{ secrets.domain }}/
      meta_description: Open Caucus conference management
      meta_publisher: vps-devops

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf conference_tool_application
      policy: !KeyOf conference_tool_access_policy
      order: 0
{% endif %}
