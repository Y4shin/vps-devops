---
# yamllint config used by ansible-lint (and standalone `yamllint`).
extends: default

rules:
  # Long Traefik label/forwardauth lines and env heredocs are intentional.
  line-length: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  # ansible-lint requires both forbid flags true; all our modes are quoted strings
  # ("0644") so this never triggers.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  collections/
  test/
  *.sops.yaml
  *.sops.yml
