version: 1
metadata:
  name: n8n-access
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: n8n_access_group
    state: present
    identifiers:
      name: {{ n8n_access_group | to_json }}
    attrs:
      name: {{ n8n_access_group | to_json }}
      users:
        - !Find [authentik_core.user, [username, akadmin]]

  - model: authentik_policies_expression.expressionpolicy
    id: n8n_access_policy
    state: present
    identifiers:
      name: n8n requires {{ n8n_access_group }}
    attrs:
      name: n8n requires {{ n8n_access_group }}
      expression: |
        user = getattr(request, "user", None)
        return bool(
            user
            and user.is_authenticated
            and user.ak_groups.filter(name={{ n8n_access_group | to_json }}).exists()
        )

  - model: authentik_providers_proxy.proxyprovider
    id: n8n_proxy_provider
    state: present
    identifiers:
      name: {{ n8n_proxy_provider_name | to_json }}
    attrs:
      name: {{ n8n_proxy_provider_name | to_json }}
      external_host: https://n8n.{{ secrets.domain }}
      mode: forward_single
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]

  - model: authentik_core.application
    id: n8n_application
    state: present
    identifiers:
      slug: {{ n8n_application_slug | to_json }}
    attrs:
      name: n8n
      slug: {{ n8n_application_slug | to_json }}
      provider: !KeyOf n8n_proxy_provider
      meta_launch_url: https://n8n.{{ secrets.domain }}
      meta_description: n8n workflow automation
      meta_publisher: vps-devops

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf n8n_application
      policy: !KeyOf n8n_access_policy
      order: 0

  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      providers:
        - !KeyOf n8n_proxy_provider
