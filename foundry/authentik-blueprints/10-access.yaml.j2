version: 1
metadata:
  name: foundry-access
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: foundry_access_group
    state: present
    identifiers:
      name: {{ foundry_access_group | to_json }}
    attrs:
      name: {{ foundry_access_group | to_json }}

  - model: authentik_policies_expression.expressionpolicy
    id: foundry_access_policy
    state: present
    identifiers:
      name: foundry requires {{ foundry_access_group }}
    attrs:
      name: foundry requires {{ foundry_access_group }}
      expression: |
        user = getattr(request, "user", None)
        return bool(
            user
            and user.is_authenticated
            and user.ak_groups.filter(name={{ foundry_access_group | to_json }}).exists()
        )

  - model: authentik_providers_proxy.proxyprovider
    id: foundry_proxy_provider
    state: present
    identifiers:
      name: {{ foundry_proxy_provider_name | to_json }}
    attrs:
      name: {{ foundry_proxy_provider_name | to_json }}
      external_host: https://{{ foundry_public_hostname }}
      mode: forward_single
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]

  - model: authentik_core.application
    id: foundry_application
    state: present
    identifiers:
      slug: {{ foundry_application_slug | to_json }}
    attrs:
      name: Foundry VTT
      slug: {{ foundry_application_slug | to_json }}
      provider: !KeyOf foundry_proxy_provider
      icon: https://authentik.{{ secrets.domain }}/media/custom/foundry-logo.png
      meta_launch_url: https://{{ foundry_public_hostname }}
      meta_description: Access to the Foundry VTT instance
      meta_publisher: vps-devops

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf foundry_application
      policy: !KeyOf foundry_access_policy
      order: 0
